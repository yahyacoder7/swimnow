# =============================================================================
# SwimNow — environment variables (TEMPLATE)
# -----------------------------------------------------------------------------
# Copy the SAME values into your ".env" file, then edit them:
#     cp .env.example .env
# ".env" is git-ignored — NEVER commit real credentials.
# =============================================================================

# ---- PostgreSQL -------------------------------------------------------------
# Superuser name and the database created on first start
POSTGRES_USER=swimnow
# Keep this secret. Change it to something long and random.
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=swimnow
# Host port mapped to Postgres's 5432 (change if 5432 is already in use)
POSTGRES_PORT=5432

# Connection string used by Prisma / the NestJS app.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
# If your password contains @ : / ? # &, URL-encode those characters.
DATABASE_URL=postgresql://swimnow:change-me-strong-password@localhost:5432/swimnow

# ---- MinIO (S3-compatible object storage) -----------------------------------
# Root access key / secret (must be at least 3 and 8 characters)
MINIO_ROOT_USER=swimnow-minio
MINIO_ROOT_PASSWORD=change-me-strong-secret

# Host ports
MINIO_API_PORT=9000        # S3 API  -> http://localhost:9000
MINIO_CONSOLE_PORT=9001    # Web UI  -> http://localhost:9001

# What the app uses to reach the S3 API
MINIO_ENDPOINT=http://localhost:9000
# Buckets the app will use for media
MINIO_BUCKET_MEDIA=media
MINIO_BUCKET_AVATARS=avatars

# ---- General ----------------------------------------------------------------
TZ=UTC
